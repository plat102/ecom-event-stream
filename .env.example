# ── Kafka source (external) ──────────────────────────────────────────
SOURCE_KAFKA_BROKERS=
SOURCE_KAFKA_TOPIC=
SOURCE_KAFKA_GROUP_ID=
SOURCE_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SOURCE_KAFKA_SASL_MECHANISM=PLAIN
SOURCE_KAFKA_SASL_USERNAME=
SOURCE_KAFKA_SASL_PASSWORD=

# ── Kafka self-hosted (from docker-compose) ─────────────────────────
SINK_KAFKA_BROKERS=localhost:9094
SINK_KAFKA_TOPIC=user-events
SINK_KAFKA_DLQ_TOPIC=user-events-dlq
SINK_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SINK_KAFKA_SASL_MECHANISM=PLAIN
SINK_KAFKA_SASL_USERNAME=kafka
SINK_KAFKA_SASL_PASSWORD=

# ── Kafka cluster (docker-compose) ───────────────────────────────────
# Generate with: docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
CLUSTER_ID=

# ── AKHQ ──────────────────────────────────────────────────────────────
# AKHQ_KAFKA_SASL_PASSWORD must match SINK_KAFKA_SASL_PASSWORD
AKHQ_KAFKA_SASL_PASSWORD=
# AKHQ_ADMIN_PASSWORD_HASH: SHA-256 hash of the AKHQ admin login password
AKHQ_ADMIN_PASSWORD_HASH=
AKHQ_JWT_SECRET=

# ── MongoDB ───────────────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_HOST=localhost:27017
MONGO_USER=admin
MONGO_PASSWORD=
MONGO_DB=ecom_events

# ── PostgreSQL (analytics warehouse) ─────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecom_analytics
POSTGRES_USER=ecom
POSTGRES_PASSWORD=

# ── Tuning ────────────────────────────────────────────────────────────
# mongo_sink: docs per insert_many
BATCH_SIZE=500
FLUSH_INTERVAL_SECONDS=2.0
# bridge: messages produced before source offsets are committed
BRIDGE_BATCH_SIZE=100
BRIDGE_FLUSH_INTERVAL_SECONDS=1.0

# ── Logging ──────────────────────────────────────────────────────────
LOG_FORMAT=pretty

# ── Airflow ───────────────────────────────────────────────────────────
# Must equal `id -u`, or tasks cannot write to the bind-mounted logs directory.
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
# Owner of the `airflow` database. URL-safe only — it goes into a SQLAlchemy URL.
# Generate with: openssl rand -hex 16
AIRFLOW_METADATA_PASSWORD=
# Encrypts connection passwords at rest; empty means no encryption.
# Generate with: openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=

